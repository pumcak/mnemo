# Copy this file to .env at the root of the repository and fill it in.
# The filled copy holds a secret and is ignored by git.

# TMDB read access token, from the API section of a TMDB account.
# Without it, films and western series stay unresolved. Anime still resolves
# through AniList, which needs no key.
MNEMO_TMDB_TOKEN=

# How often sessions waiting for a resolution are looked at, in minutes.
MNEMO_RESOLVE_INTERVAL_MINUTES=10
